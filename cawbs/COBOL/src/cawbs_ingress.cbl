       IDENTIFICATION DIVISION.
       PROGRAM-ID. CAWBSINGRESS.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY "CAWBSWS.cpy".
       01  CAWBS-EVENT-NAME         PIC X(128) VALUE "OrderCreated".
       01  CAWBS-EVENT-SOURCE       PIC X(128) VALUE SPACES.
       01  CAWBS-PAYLOAD-JSON       PIC X(8192) VALUE '{"orderId":"123"}'.
       PROCEDURE DIVISION.
           CALL "CAWBSINGRESSINIT" USING CAWBS-STATUS CAWBS-ERROR
           IF CAWBS-STATUS NOT = 200
               DISPLAY "Init failed: " CAWBS-ERROR
               STOP RUN
           END-IF
           CALL "CAWBSINGRESSPOSTEVENT" USING CAWBS-STATUS CAWBS-ANSWER
               CAWBS-ERROR CAWBS-EVENT-NAME CAWBS-PAYLOAD-JSON CAWBS-EVENT-SOURCE
           IF CAWBS-STATUS NOT = 200
               DISPLAY "PostEvent failed: " CAWBS-ERROR
               STOP RUN
           END-IF
           DISPLAY "Posted: " CAWBS-ANSWER
           STOP RUN.
